{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "formatter": false,
  // OpenCode runs only on Jamie's machine (D44), so a local MCP server path is safe to carry in
  // every repo. The GitHub MCP server reads PR context without shelling out.
  "mcp": {
    "github": {
      "type": "local",
      "command": ["/home/jamie-nisbet/go/bin/github-mcp-server", "stdio"],
      "environment": {
        "GITHUB_TOOLSETS": "context,pull_requests"
      },
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "*": "allow",

      "* build*": "deny",
      "*:build*": "deny",
      "* lint*": "deny",
      "* typecheck*": "deny",
      "* test*": "deny",
      "* format*": "deny",
      "* dev*": "deny",
      "*:dev*": "deny",
      "* start*": "deny",
      "* preview*": "deny",
      "tsc*": "deny",
      "* tsc*": "deny",
      "eslint*": "deny",
      "* eslint*": "deny",
      "prettier*": "deny",
      "* prettier*": "deny",
      "vitest*": "deny",
      "* vitest*": "deny",
      "* jest*": "deny",
      "* playwright*": "deny",
      "next *": "deny",
      "* next *": "deny",

      "git *": "allow",
      "gh *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "cat *": "allow",
      "ls *": "allow",
      "sed *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "jq *": "allow",

      // Push gate. Bash permissions are last-match-wins over the whole command, so
      // the claude/* allow must stay BELOW the ask to win — swap the two lines and
      // every push asks again. Pushing a claude/* branch runs unattended because the
      // PR review on GitHub is the real gate; main and everything else still ask.
      // Caveat: a bare `git push` (upstream already set) names no branch, so it
      // matches only the ask — correct, and prompts always name the branch.
      "git push*": "ask",
      "git push* claude/*": "allow"
    }
  }
}
